{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission",
    "outcome",
    "execution",
    "missing_inputs",
    "approval_gates",
    "acceptance",
    "confidence",
    "reason"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "admission": {
      "type": "string",
      "enum": ["no_capture", "capture_only", "dispatch", "clarify"]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "item_id", "title"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["no_capture", "attach_existing", "create_new", "clarify"]
        },
        "item_id": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "skill_ids", "tool_operations", "forbidden_operations"],
      "properties": {
        "workflow_id": {"type": ["string", "null"]},
        "skill_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "tool_operations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_operations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "approval_gates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1}
  }
}
