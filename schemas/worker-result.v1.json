{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmd.local/schemas/worker-result.v1.json",
  "title": "CMD public-alpha worker result v1",
  "type": "object",
  "required": ["schema_version", "dispatch_id", "receipts"],
  "properties": {
    "schema_version": {"const": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/receipt"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "receipt": {
      "type": "object",
      "required": ["action_id", "status", "summary"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["completed", "awaiting_approval", "blocked", "failed"]
        },
        "summary": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1},
        "artifact": {
          "oneOf": [
            {"type": "object", "minProperties": 1},
            {"type": "string", "minLength": 1}
          ]
        },
        "needs_human_review": {"type": "boolean"},
        "human_action": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "object", "minProperties": 1}
            ]
          }
        },
        "model": {"type": "string"},
        "proposed_operation": {
          "type": "object",
          "required": ["capability", "execution_mode", "risk_level", "payload"],
          "properties": {
            "capability": {"type": "string", "minLength": 1},
            "execution_mode": {"const": "execute"},
            "risk_level": {"type": "string", "minLength": 1},
            "payload": {"type": "object", "minProperties": 1}
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {
            "anyOf": [
              {"required": ["artifact"]},
              {"required": ["conclusion"]},
              {
                "required": ["sources"],
                "properties": {"sources": {"minItems": 1}}
              }
            ]
          }
        },
        {
          "if": {"properties": {"status": {"const": "awaiting_approval"}}},
          "then": {"required": ["proposed_operation"]}
        }
      ],
      "additionalProperties": true
    }
  }
}
