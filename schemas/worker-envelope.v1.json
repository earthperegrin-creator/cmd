{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmd.local/schemas/worker-envelope.v1.json",
  "title": "CMD public-alpha worker envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "dispatch",
    "actions",
    "profile",
    "policy",
    "tools",
    "skills",
    "workflows"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dispatch": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "instruction": {"type": "string"},
          "resolved_item_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "profile": {"type": "object"},
    "policy": {"type": "object"},
    "tools": {"type": "object"},
    "skills": {"type": "object"},
    "workflows": {"type": "object"}
  },
  "additionalProperties": false,
  "$comment": "This bounded alpha envelope is not a compiled JobSpec and does not itself grant a connector operation."
}

