# CMD keeps private state outside the product checkout by default.
# Uncomment only when you intentionally want a custom location.
# CMD_HOME="$HOME/Library/Application Support/CMD"
# CMD_STATE_DIR="$CMD_HOME/state"
# CMD_CONTEXT_DIR="$HOME/my-private-context"

# Fresh connectors and workers are disabled until onboarding confirms them.
CMD_WORKSPACE_TITLE="My Command"
CMD_WORKSPACE_LABEL="LOCAL WORKSPACE"
CMD_FOCUS_LABEL="HUMAN + AGENTS"

# Required only if CMD is intentionally bound beyond localhost.
# CMD_AUTH_TOKEN="replace-with-a-long-random-token"
